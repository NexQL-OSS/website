{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.nexql.astrx.dev/api/:path*"
    }
  ],
  "redirects": [
    { "source": "/terms.html", "destination": "/terms", "permanent": true },
    { "source": "/privacy.html", "destination": "/privacy", "permanent": true }
  ],
  "crons": [
    { "path": "/api/cron/license-expiry", "schedule": "0 3 * * *" },
    { "path": "/api/cron/sync-purge-inactive", "schedule": "0 4 * * *" }
  ]
}
