---
import DocsLayout from "../../layouts/DocsLayout.astro";
import FeatureStory from "../../components/FeatureStory.astro";
import { FEATURES, FEATURES_ORDERED, getFeature, featureHref, plainTitle } from "../../data/feature-stories";
import { SITE_URL } from "../../data/site";

export function getStaticPaths() {
  return FEATURES.map((f) => ({ params: { slug: f.slug } }));
}

const { slug } = Astro.params;
const feature = getFeature(slug!);
if (!feature) return Astro.redirect("/features/");

const i = FEATURES_ORDERED.findIndex((f) => f.slug === feature.slug);
const prev = FEATURES_ORDERED[i - 1];
const next = FEATURES_ORDERED[i + 1];

const title = `${plainTitle(feature.title)} | NexQL`;
const canonical = `${SITE_URL}/features/${feature.slug}`;
---

<DocsLayout
  {title}
  description={feature.lede}
  {canonical}
  crumbs={[{ label: "Docs", href: "/docs" }, { label: "Features", href: "/features" }, { label: feature.name }]}
  prev={prev && { href: featureHref(prev.slug), label: prev.name }}
  next={next && { href: featureHref(next.slug), label: next.name }}
>
  <FeatureStory {feature} />
</DocsLayout>
