---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { GROUPS, FEATURES, featureHref } from "../../data/feature-stories";
import { MARKETPLACE_URL, SITE_URL } from "../../data/site";

const title = "NexQL features: notebooks, explorer, AI assistant, safety and more";
const description =
  "How NexQL's notebooks, explorer, AI assistant, Sentinel safety, schema tools, Plan Studio, dashboard and cloud sync work inside VS Code.";
const canonical = `${SITE_URL}/features`;
---

<DocsLayout {title} {description} {canonical} crumbs={[{ label: "Features" }]} width="wide">
  <p class="eyebrow">Features</p>
  <h1>Eight workflows, one <span class="serif-em grad-text">editor</span>.</h1>
  <p class="lede">
    Each page covers one part of NexQL: what it does, how you use it step by step, and what is free or Pro.
  </p>
  <p class="actions">
    <a class="btn btn-primary" href={MARKETPLACE_URL} target="_blank" rel="noopener noreferrer">Install from Marketplace</a>
  </p>

  {
    GROUPS.map((g) => (
      <section aria-labelledby={`g-${g.id}`}>
        <h2 id={`g-${g.id}`}>{g.label}</h2>
        <p class="sub">{g.blurb}</p>
        <div class="cards">
          {FEATURES.filter((f) => f.group === g.id).map((f) => (
            <a class="card" href={featureHref(f.slug)}>
              <span class="tier">{f.tierLabel}</span>
              <strong>{f.name}</strong>
              <span class="s">{f.summary}</span>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</DocsLayout>

<style>
  h1 {
    max-width: 18ch;
  }
  .actions {
    margin-top: 22px;
  }
  .actions .btn {
    text-decoration: none;
  }
  section {
    margin-top: 48px;
  }
  h2 {
    font-size: 26px;
  }
  .sub {
    color: var(--muted);
    margin-top: 6px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 12px;
    margin-top: 18px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px;
    border: 1px solid;
    border-color: var(--bevel-border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-2);
    color: var(--fg);
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  @media (prefers-reduced-motion: no-preference) {
    .card:hover {
      transform: translateY(-2px);
    }
  }
  .card:hover {
    border-color: var(--accent);
    text-decoration: none;
    box-shadow: var(--shadow-3);
  }
  .tier {
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .s {
    color: var(--muted);
    font-size: 14.5px;
  }
</style>
