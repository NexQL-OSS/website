---
import DocsLayout from "../../../layouts/DocsLayout.astro";
import ProBadge from "../../../components/docs/ProBadge.astro";
import { MANIFEST, formatKey, describeWhen } from "../../../data/docs";
import { SITE_URL } from "../../../data/site";

const title = "NexQL keyboard shortcuts for Windows, Linux and macOS";
const description = "The default keybindings NexQL adds to VS Code, with the command each one runs, where it applies, and the shortcut on Windows, Linux and macOS.";
const canonical = `${SITE_URL}/docs/reference/shortcuts`;

const rows = MANIFEST.keybindings;
---

<DocsLayout
  {title}
  {description}
  {canonical}
  crumbs={[{ label: "Docs", href: "/docs" }, { label: "Reference", href: "/docs/reference" }, { label: "Shortcuts" }]}
  width="wide"
>
  <p class="eyebrow">Reference</p>
  <h1>Keyboard <span class="serif-em grad-text">shortcuts</span>.</h1>
  <p class="lede">
    {rows.length} default keybindings, generated from the NexQL {MANIFEST.version} extension manifest. Change any of them in VS Code with
    Preferences: Open Keyboard Shortcuts, then search for the command.
  </p>

  <table class="keys">
    <thead>
      <tr>
        <th scope="col">Command</th>
        <th scope="col">Windows, Linux</th>
        <th scope="col">macOS</th>
        <th scope="col">Where it applies</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((k) => {
          const w = describeWhen(k.when);
          return (
            <tr>
              <th scope="row">
                {k.title ? <a href={`/docs/reference/commands#${k.command}`}>{k.title}</a> : <span>Select all</span>}
                {k.pro && <ProBadge />}
                <code>{k.command}</code>
              </th>
              <td data-label="Windows, Linux"><kbd>{formatKey(k.key)}</kbd></td>
              <td data-label="macOS"><kbd>{formatKey(k.mac ?? k.key)}</kbd></td>
              <td data-label="Where it applies">{w.raw ? <code>{w.text}</code> : w.text}</td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
  <p class="note">
    Select all is a built-in VS Code command. NexQL adds a binding for it in notebook cell editors.
  </p>
</DocsLayout>

<style>
  .keys {
    width: 100%;
    margin-top: 28px;
    border-collapse: collapse;
    font-size: 15px;
  }
  th,
  td {
    text-align: left;
    padding: 12px 12px 12px 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  thead th {
    font: 500 11.5px/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  tbody th {
    font-weight: 600;
  }
  tbody th code {
    display: block;
    margin-top: 4px;
    background: none;
    border: 0;
    padding: 0;
    font-weight: 400;
    font-size: 12.5px;
    color: var(--muted);
    overflow-wrap: anywhere;
    word-break: break-all;
  }
  tbody th :global(.pro) {
    margin-left: 6px;
  }
  kbd {
    display: inline-block;
    padding: 1px 8px;
    border: 1px solid var(--line-2);
    border-bottom-width: 2px;
    border-radius: 6px;
    background: var(--panel-2);
    color: var(--fg);
    font-size: 13px;
    white-space: nowrap;
  }
  td code {
    overflow-wrap: anywhere;
  }
  .note {
    margin-top: 18px;
    color: var(--muted);
    font-size: 14.5px;
  }
  @media (max-width: 759px) {
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .keys,
    tbody,
    tr,
    th,
    td {
      display: block;
    }
    tr {
      padding: 12px 0;
      border-bottom: 1px solid var(--line);
    }
    th,
    td {
      border: 0;
      padding: 4px 0;
    }
    td::before {
      content: attr(data-label);
      display: block;
      font: 500 11px/1.4 var(--font-mono);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
    }
  }
</style>
