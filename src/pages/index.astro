---
/**
 * Home page. Order: header, hero, story, playground, sections, footer.
 * Section components live in src/components/landing/ (see each file's header
 * comment for who owns it and what it must contain).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/landing/Hero.astro";
import Story from "../components/landing/Story.astro";
import Playground from "../components/landing/Playground.astro";
import Sections from "../components/landing/Sections.astro";
import PageScripts from "../components/landing/PageScripts.astro";
---

<BaseLayout>
  <SiteHeader />
  <main id="main" tabindex="-1">
    <Hero />
    <Story />
    <Playground />
    <Sections />
  </main>
  <SiteFooter />
  <PageScripts />
</BaseLayout>

<style>
  /* The hero's dot grid bleeds past its box; clip, not hidden, so sticky still works. */
  main {
    overflow-x: clip;
  }
</style>
