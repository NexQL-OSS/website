---
/**
 * Layout for the Markdown task guides in src/pages/docs/guides/*.md.
 *
 * Frontmatter (all read by GUIDES in data/docs.ts; the build fails if one is missing):
 *   layout:  ../../../layouts/GuideLayout.astro
 *   title:   sentence-case task name, e.g. "Connect through an SSH tunnel"
 *   summary: one sentence; becomes the lede and the meta description
 *   area:    an AREAS id from data/docs.ts (links the guide to that reference section)
 *   order:   position in the guides list
 *   related: optional list of feature story slugs
 *
 * The body is plain Markdown rendered inside .prose. Use ## for sections and
 * ### for steps' sub-parts. Put shell and settings.json in fenced code blocks.
 */
import DocsLayout from "./DocsLayout.astro";
import { AREA_BY_ID, GUIDES, areaAnchor, commandsIn, guideHref, settingsIn } from "../data/docs";
import { FEATURES, featureHref } from "../data/feature-stories";
import { SITE_URL } from "../data/site";

const slug = Astro.url.pathname.replace(/\/$/, "").split("/").pop()!;
const i = GUIDES.findIndex((g) => g.slug === slug);
if (i < 0) throw new Error(`GuideLayout: no guide for "${slug}"`);
const guide = GUIDES[i];
const area = AREA_BY_ID.get(guide.area)!;
const prev = GUIDES[i - 1];
const next = GUIDES[i + 1];
const related = FEATURES.filter((f) => guide.related?.includes(f.slug));
const commandCount = commandsIn(area.id).length;
const settingCount = settingsIn(area.id).length;
const pad = (n: number) => String(n).padStart(2, "0");
---

<DocsLayout
  title={`${guide.title} | NexQL docs`}
  description={guide.summary}
  canonical={`${SITE_URL}${guideHref(guide.slug)}`}
  crumbs={[{ label: "Docs", href: "/docs" }, { label: "Guides", href: "/docs/guides" }, { label: guide.title }]}
  prev={prev && { href: guideHref(prev.slug), label: prev.title }}
  next={next && { href: guideHref(next.slug), label: next.title }}
>
  <p class="eyebrow">Guide {pad(i + 1)} · {area.name}</p>
  <h1>{guide.title}</h1>
  <p class="lede">{guide.summary}</p>

  <div class="prose">
    <slot />
  </div>

  <aside class="more" aria-label="Related reference">
    <p class="mono-label">Reference for {area.name}</p>
    <ul>
      {commandCount > 0 && (
        <li><a href={`/docs/reference/commands#${areaAnchor(area.id)}`}>{commandCount} command{commandCount === 1 ? "" : "s"}</a></li>
      )}
      {settingCount > 0 && (
        <li><a href={`/docs/reference/settings#${areaAnchor(area.id)}`}>{settingCount} setting{settingCount === 1 ? "" : "s"}</a></li>
      )}
      {related.map((f) => (
        <li><a href={featureHref(f.slug)}>{f.name}</a></li>
      ))}
    </ul>
  </aside>
</DocsLayout>

<style>
  .eyebrow {
    font: 500 12px/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }
  h1 {
    font-size: clamp(30px, 5vw, 42px);
    letter-spacing: -0.02em;
  }
  .lede {
    margin-top: 12px;
    font-size: 18px;
    color: var(--muted);
  }
  .prose {
    margin-top: 32px;
  }
  .more {
    margin-top: 48px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-1);
  }
  .more ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }
</style>
