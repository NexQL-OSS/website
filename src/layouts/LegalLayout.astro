---
/**
 * Shell for /terms and /privacy: DocsLayout without the feature sidebar, plus
 * a small switch between the two documents. Content goes in the default slot
 * (an <article> using the shared .prose styles).
 *
 * Props: title, description, canonical, active ("terms" | "privacy").
 */
import DocsLayout from "./DocsLayout.astro";

interface Props {
  title: string;
  description: string;
  canonical: string;
  active: "terms" | "privacy";
}

const { title, description, canonical, active } = Astro.props;
const label = active === "terms" ? "Terms of Service" : "Privacy Policy";
---

<DocsLayout {title} {description} {canonical} sidebar={false} crumbs={[{ label }]}>
  <nav class="switch" aria-label="Legal documents">
    <a href="/terms" aria-current={active === "terms" ? "page" : undefined}>Terms</a>
    <a href="/privacy" aria-current={active === "privacy" ? "page" : undefined}>Privacy</a>
  </nav>
  <slot />
</DocsLayout>

<style>
  .switch {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    margin-bottom: 24px;
    border: 1px solid var(--line);
    border-radius: 99px;
    background: var(--pill-bg);
  }
  .switch a {
    padding: 6px 16px;
    border-radius: 99px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
  }
  .switch a:hover {
    color: var(--fg);
    text-decoration: none;
  }
  .switch a[aria-current] {
    background: var(--panel-2);
    color: var(--fg);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }
</style>
