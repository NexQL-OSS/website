---
/**
 * Docs shell for /docs/*, /features/*, /privacy and /terms. Modelled on the
 * NexQL MCP docs layout: BaseLayout + SiteHeader + SiteFooter, a sidebar with
 * the docs navigation (Getting started, Guides, Features, Reference; a
 * disclosure on phones), a breadcrumb, the page, and previous / next links.
 * The navigation lives in data/docs.ts (DOCS_NAV).
 *
 * Props
 *  - title, description, canonical: per-page SEO (required).
 *  - crumbs:   { label, href? }[]. Breadcrumb after "Home". Last item is the page.
 *  - prev/next: { href, label }, optional. Shown under the page.
 *  - sidebar:  boolean, default true. false gives a single centred column (legal pages).
 *  - width:    "prose" (default, 76ch) | "wide".
 *
 * Page content goes in the default slot. Prose styling applies to anything
 * inside <div class="prose">.
 */
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { DOCS_NAV } from "../data/docs";

interface Link {
  href: string;
  label: string;
}
interface Props {
  title: string;
  description: string;
  canonical: string;
  crumbs?: { label: string; href?: string }[];
  prev?: Link;
  next?: Link;
  sidebar?: boolean;
  width?: "prose" | "wide";
}

const { title, description, canonical, crumbs = [], prev, next, sidebar = true, width = "prose" } = Astro.props;
const norm = (p: string) => p.replace(/\/$/, "") || "/";
const path = norm(Astro.url.pathname);
const isOn = (href: string) => norm(href) === path;
const here = crumbs.length ? crumbs[crumbs.length - 1].label : title;
// Keep the Features group open on any /features page.
const onFeatures = path === "/features" || path.startsWith("/features/");
---

<BaseLayout {title} {description} {canonical}>
  <SiteHeader />
  <div class:list={["wrap", "docs", { "docs--solo": !sidebar }]}>
    {
      sidebar && (
        <aside class="side" aria-label="Documentation">
          <details class="menu" open>
            <summary class="menu-toggle">
              <span>Docs menu</span>
              <span class="here">{path === "/docs" ? "Overview" : here}</span>
            </summary>
            <nav class="map" aria-label="Docs pages">
              <a class:list={["map-top", { on: isOn("/docs") }]} href="/docs" aria-current={isOn("/docs") ? "page" : undefined}>
                Docs overview
              </a>
              {DOCS_NAV.filter((sec) => sec.links.length > 0 || sec.groups?.length).map((sec) =>
                sec.id === "features" ? (
                  <details class="sec" open={onFeatures}>
                    <summary class="map-h">{sec.label}</summary>
                    <a class:list={["map-top", { on: isOn(sec.overview!.href) }]} href={sec.overview!.href} aria-current={isOn(sec.overview!.href) ? "page" : undefined}>
                      {sec.overview!.label}
                    </a>
                    {sec.groups!.map((g) => (
                      <>
                        <p class="map-sub">{g.label}</p>
                        <ul>
                          {g.links.map((l) => (
                            <li>
                              <a class:list={{ on: isOn(l.href) }} href={l.href} aria-current={isOn(l.href) ? "page" : undefined}>
                                {l.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </>
                    ))}
                  </details>
                ) : (
                  <>
                    <p class="map-h">{sec.label}</p>
                    <ul>
                      {sec.overview && (
                        <li>
                          <a class:list={{ on: isOn(sec.overview.href) }} href={sec.overview.href} aria-current={isOn(sec.overview.href) ? "page" : undefined}>
                            {sec.overview.label}
                          </a>
                        </li>
                      )}
                      {sec.links.map((l) => (
                        <li>
                          <a class:list={{ on: isOn(l.href) }} href={l.href} aria-current={isOn(l.href) ? "page" : undefined}>
                            {l.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                ),
              )}
            </nav>
          </details>
        </aside>
      )
    }

    <main class:list={["doc", `doc--${width}`]} id="main" tabindex="-1">
      {
        crumbs.length > 0 && (
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/">Home</a>
            {crumbs.map((c, i) => (
              <>
                <span aria-hidden="true">/</span>
                {c.href && i < crumbs.length - 1 ? (
                  <a href={c.href}>{c.label}</a>
                ) : (
                  <span aria-current="page">{c.label}</span>
                )}
              </>
            ))}
          </nav>
        )
      }
      <slot />
      {
        (prev || next) && (
          <nav class="pager" aria-label="Previous and next page">
            {prev ? (
              <a class="pg prev" href={prev.href}>
                <span class="dir">← Previous</span>
                <strong>{prev.label}</strong>
              </a>
            ) : (
              <span />
            )}
            {next ? (
              <a class="pg next" href={next.href}>
                <span class="dir">Next →</span>
                <strong>{next.label}</strong>
              </a>
            ) : (
              <a class="pg next" href="/docs">
                <span class="dir">End of the list</span>
                <strong>Docs overview</strong>
              </a>
            )}
          </nav>
        )
      }
    </main>
  </div>
  <SiteFooter />
</BaseLayout>

<script>
  // The menu is a disclosure on phones and always open on wide screens.
  const menu = document.querySelector<HTMLDetailsElement>("details.menu");
  if (menu) {
    const wide = matchMedia("(min-width: 960px)");
    const sync = () => (menu.open = wide.matches);
    sync();
    wide.addEventListener("change", sync);
    // On wide screens, bring the current page's link into view inside the sidebar only.
    const side = document.querySelector<HTMLElement>(".side");
    const on = document.querySelector<HTMLElement>(".map .on");
    if (side && on && wide.matches) side.scrollTop = on.offsetTop - side.clientHeight / 2;
  }
</script>

<style>
  .docs {
    display: grid;
    gap: 28px;
    padding-top: 24px;
    padding-bottom: 24px;
  }
  @media (min-width: 960px) {
    .docs {
      grid-template-columns: 250px minmax(0, 1fr);
      gap: 56px;
      padding-top: 40px;
    }
    .docs--solo {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .side {
    min-width: 0;
  }
  @media (min-width: 960px) {
    .side {
      position: sticky;
      top: calc(var(--header-h) + 24px);
      align-self: start;
      max-height: calc(100vh - var(--header-h) - 48px);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-right: 8px;
      scrollbar-width: thin;
    }
  }
  .menu {
    border: 1px solid;
    border-color: var(--bevel-border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-2);
  }
  @media (min-width: 960px) {
    .menu {
      border: 0;
      background: none;
      box-shadow: none;
    }
  }
  .menu-toggle {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    min-height: 44px;
    align-items: center;
    cursor: pointer;
    font-weight: 600;
    list-style: none;
  }
  .menu-toggle::-webkit-details-marker {
    display: none;
  }
  @media (min-width: 960px) {
    .menu-toggle {
      display: none;
    }
  }
  .menu-toggle .here {
    color: var(--muted);
    font-weight: 400;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .map {
    padding: 4px 14px 16px;
    font-size: 14.5px;
  }
  @media (min-width: 960px) {
    .map {
      padding: 0;
    }
  }
  .map ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .map a {
    display: block;
    padding: 6px 8px;
    border-radius: 6px;
    color: var(--muted);
  }
  .map a:hover {
    color: var(--fg);
    text-decoration: none;
    background: var(--panel-2);
  }
  .map a.on {
    color: var(--fg);
    background: var(--panel-2);
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .map-top {
    font-weight: 600;
  }
  .sec > summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 32px;
  }
  .sec > summary::-webkit-details-marker {
    display: none;
  }
  .sec > summary::after {
    content: "+";
    font-size: 16px;
    color: var(--muted);
    margin-right: 8px;
  }
  .sec[open] > summary::after {
    content: "\2212";
  }
  .map-sub {
    font: 500 12px/1 var(--font-mono);
    color: var(--muted);
    margin: 12px 8px 4px;
  }
  .map-h {
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 20px 8px 6px;
  }

  .doc {
    min-width: 0;
  }
  .doc--prose > :global(*) {
    max-width: 76ch;
  }
  .docs--solo .doc--prose {
    max-width: 76ch;
    margin: 0 auto;
    width: 100%;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 14px;
    color: var(--faint);
    margin-bottom: 22px;
  }
  .crumbs a {
    color: var(--muted);
  }
  .crumbs [aria-current] {
    color: var(--muted);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-top: 56px;
    max-width: 76ch;
  }
  @media (min-width: 640px) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }
  }
  .pg {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 18px;
    border: 1px solid;
    border-color: var(--bevel-border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-2);
    color: var(--fg);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .pg.next {
    text-align: right;
    align-items: flex-end;
  }
  .pg:hover {
    border-color: var(--accent);
    text-decoration: none;
    box-shadow: var(--shadow-3);
  }
  .dir {
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>

<style is:global>
  /* Shared docs typography. */
  .doc .eyebrow {
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }
  .doc h1 {
    font-size: clamp(32px, 5vw, 46px);
    font-weight: 700;
    overflow-wrap: break-word;
  }
  .doc .lede {
    color: var(--muted);
    font-size: 18.5px;
    margin-top: 14px;
    max-width: 68ch;
  }
  .prose > * + * {
    margin-top: 16px;
  }
  .prose h2 {
    font-size: 26px;
    margin-top: 44px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .prose h3 {
    font-size: 19px;
    margin-top: 28px;
  }
  .prose p,
  .prose li {
    color: var(--prose);
  }
  .prose ul,
  .prose ol {
    padding-left: 22px;
  }
  .prose li + li {
    margin-top: 6px;
  }
  .prose strong {
    color: var(--fg);
  }
  .prose a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .prose table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 14.5px;
  }
  .prose th,
  .prose td {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .prose tr:last-child td {
    border-bottom: 0;
  }
  .prose th {
    font: 500 11.5px/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
