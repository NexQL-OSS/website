---
/** #faq. FAQS from landing-content.ts as native <details> disclosures (keyboard and screen reader friendly). */
import SectionHead from "../ui/SectionHead.astro";
import { FAQS } from "../../data/landing-content";
---

<section class="band wrap" id="faq" aria-labelledby="faq-title">
  <div class="narrow">
    <SectionHead eyebrow="FAQ" id="faq-title">
      Questions people <span class="serif-em">actually</span> ask
    </SectionHead>
    <div class="faq">
      {
        FAQS.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .band {
    padding-block: 56px;
  }
  @media (min-width: 720px) {
    .band {
      padding-block: 80px;
    }
  }
  .narrow {
    max-width: 46rem;
    margin-inline: auto;
  }
  .faq {
    display: grid;
    gap: 8px;
    margin-top: 28px;
  }
  details {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: var(--shadow-1);
    padding: 0 16px;
  }
  details[open] {
    box-shadow: var(--shadow-2);
  }
  summary {
    position: relative;
    list-style: none;
    cursor: pointer;
    padding: 14px 28px 14px 0;
    font-weight: 500;
    border-radius: 8px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "";
    position: absolute;
    right: 4px;
    top: 50%;
    width: 8px;
    height: 8px;
    margin-top: -6px;
    border-right: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    transform: rotate(45deg);
    transition: transform 0.15s;
  }
  details[open] > summary::after {
    margin-top: -2px;
    transform: rotate(-135deg);
  }
  summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  details p {
    padding-bottom: 16px;
    color: var(--muted);
    font-size: 15px;
  }
</style>
