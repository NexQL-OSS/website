---
/**
 * Static mock of the connection form and the status bar badge. Decorative:
 * built in HTML/CSS with brand tokens, no JS. The environment buttons are
 * pure CSS (radio inputs) so the visitor can try DEV / STAGE / PROD.
 */
import { ENVS } from "../../data/story";
---

<div class="mock" aria-label="Illustration of the NexQL connection form">
  <div class="form">
    <p class="mono-label">New connection</p>
    <div class="row">
      <div class="field grow"><span class="k">Host</span><span class="v">db.example.com</span></div>
      <div class="field port"><span class="k">Port</span><span class="v">5432</span></div>
    </div>
    <div class="row">
      <div class="field grow"><span class="k">Username</span><span class="v">app_user</span></div>
      <div class="field grow"><span class="k">Password</span><span class="v">••••••••</span></div>
    </div>
    <fieldset class="envs">
      <legend class="k">Environment</legend>
      {
        ENVS.map((e, i) => (
          <>
            <input type="radio" name="mock-env" id={`mock-env-${e.id}`} checked={i === 2} />
            <label for={`mock-env-${e.id}`} class={e.cls}>
              {e.label}
            </label>
          </>
        ))
      }
    </fieldset>
    <div class="row opts">
      <span class="chip">SSH tunnel</span>
      <span class="chip">SSL</span>
      <span class="chip">Read-only</span>
    </div>
  </div>

  <div class="status" aria-hidden="true">
    <span class="s-left">⎇ nexql</span>
    <span class="badge dev">● DEVELOPMENT</span>
    <span class="badge stage">● STAGING</span>
    <span class="badge prod">● PRODUCTION</span>
  </div>
</div>

<style>
  .mock {
    margin-top: 28px;
    border-radius: 14px;
    border: 1px solid;
    border-color: var(--bevel-border);
    background: var(--surface);
    box-shadow: var(--shadow-3);
    overflow: hidden;
    max-width: 640px;
  }
  .form {
    padding: 18px 20px 20px;
    display: grid;
    gap: 12px;
  }
  .row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .grow {
    flex: 1 1 160px;
  }
  .port {
    flex: 0 0 90px;
  }
  .field {
    display: grid;
    gap: 4px;
    padding: 8px 12px;
    border-radius: 8px;
    background: var(--well);
    box-shadow: var(--well-shadow);
    min-width: 0;
  }
  .k {
    font: 500 11.5px/1.2 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .v {
    font: 400 14px/1.3 var(--font-mono);
    color: var(--prose);
    overflow-wrap: anywhere;
  }
  .envs {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .envs legend {
    float: left;
    margin-right: 6px;
    padding: 0;
  }
  .envs input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .envs label {
    cursor: pointer;
    padding: 7px 14px;
    min-height: 34px;
    border-radius: 99px;
    border: 1px solid var(--line-2);
    font: 600 12.5px/1.2 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--muted);
    background: var(--control-bg);
    box-shadow: var(--control-shadow);
    display: inline-flex;
    align-items: center;
  }
  .envs input:focus-visible + label {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .envs input:checked + label {
    color: var(--fg);
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent) inset;
  }
  .chip {
    font: 500 12.5px/1 var(--font-mono);
    padding: 7px 11px;
    border-radius: 99px;
    border: 1px dashed var(--line-2);
    color: var(--muted);
  }
  .opts {
    gap: 8px;
  }

  /* Status bar strip. Only the badge matching the picked env shows. */
  .status {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 7px 16px;
    font: 500 12px/1.2 var(--font-mono);
    color: var(--muted);
    background: var(--well);
    border-top: 1px solid var(--line);
  }
  .s-left {
    margin-right: auto;
  }
  .badge {
    display: none;
    padding: 3px 10px;
    border-radius: 4px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--on-grad);
  }
  .badge.dev {
    background: var(--ok);
  }
  .badge.stage {
    background: var(--warn);
  }
  .badge.prod {
    background: #ff8f6b;
  }
  .mock:has(#mock-env-dev:checked) .badge.dev,
  .mock:has(#mock-env-stage:checked) .badge.stage,
  .mock:has(#mock-env-prod:checked) .badge.prod {
    display: inline-block;
  }
  .mock:has(#mock-env-prod:checked) {
    border-color: #ff8f6b;
  }
</style>
