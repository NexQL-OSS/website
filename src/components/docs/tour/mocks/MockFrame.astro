---
/**
 * Window chrome for the tour's drawn mocks: a title strip and a body. The mock
 * is decorative (aria-hidden); the page text carries the same information.
 *
 * Props: title (string, mono text in the strip), max (CSS width, default 640px),
 * decorative (default true; false keeps the mock in the accessibility tree).
 */
interface Props {
  title: string;
  max?: string;
  decorative?: boolean;
}
const { title, max = "640px", decorative = true } = Astro.props;
---

<div class="frame" style={`max-width:${max}`} aria-hidden={decorative ? "true" : undefined}>
  <div class="bar"><span class="lights"><i></i><i></i><i></i></span><span class="t">{title}</span></div>
  <div class="body"><slot /></div>
</div>

<style>
  .frame {
    margin-top: 28px;
    border-radius: 14px;
    border: 1px solid;
    border-color: var(--bevel-border);
    background: var(--surface);
    box-shadow: var(--shadow-3);
    overflow: hidden;
    min-width: 0;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 14px;
    background: var(--well);
    border-bottom: 1px solid var(--line);
    font: 500 12px/1.2 var(--font-mono);
    color: var(--faint);
    min-width: 0;
  }
  .lights {
    display: inline-flex;
    gap: 6px;
    flex: none;
  }
  .lights i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line-2);
  }
  .t {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
