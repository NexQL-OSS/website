---
/** Stop 6: the confirmation a write on a production connection opens (decorative). */
import MockFrame from "./MockFrame.astro";
---

<MockFrame title="shop-prod · PRODUCTION" max="560px">
  <div class="dlg">
    <p class="warn">⚠ PRODUCTION DATABASE ⚠</p>
    <pre>UPDATE orders SET status = 'void' WHERE id = 4182;</pre>
    <div class="btns">
      <span class="b main">Execute</span>
      <span class="b">Execute in Transaction</span>
      <span class="b">Cancel</span>
    </div>
  </div>
  <div class="status">
    <span class="s-left">⎇ nexql</span>
    <span class="badge">● PRODUCTION</span>
  </div>
</MockFrame>

<style>
  .dlg {
    padding: 18px;
    display: grid;
    gap: 12px;
  }
  .warn {
    margin: 0;
    font: 700 13px/1.3 var(--font-mono);
    color: #ff8f6b;
    letter-spacing: 0.04em;
  }
  pre {
    margin: 0;
    padding: 10px 12px;
    border-radius: 8px;
    background: var(--well);
    box-shadow: var(--well-shadow);
    font: 400 13px/1.5 var(--font-mono);
    color: var(--fg);
    overflow-x: auto;
  }
  .btns {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .b {
    padding: 8px 14px;
    border-radius: 8px;
    border: 1px solid var(--line-2);
    background: var(--control-bg);
    box-shadow: var(--control-shadow);
    color: var(--prose);
    font-size: 13px;
  }
  .b.main {
    background: var(--btn-primary-bg);
    color: var(--accent-ink);
    border-color: transparent;
  }
  .status {
    display: flex;
    align-items: center;
    padding: 7px 16px;
    font: 500 12px/1.2 var(--font-mono);
    color: var(--muted);
    background: var(--well);
    border-top: 1px solid var(--line);
  }
  .s-left {
    margin-right: auto;
  }
  .badge {
    padding: 3px 10px;
    border-radius: 4px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--on-grad);
    background: #ff8f6b;
  }
</style>
